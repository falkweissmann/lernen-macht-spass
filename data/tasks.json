{
  "tasks": [
    {
      "id": "linear_eq_01",
      "topicId": "class7_linear_equations",
      "title": "Lineare Gleichung lösen",
      "description": "Finde den Wert von x in der folgenden Gleichung",
      "type": "input",
      "difficulty": 1,
      "points": 10,
      "timeLimit": 120,
      "randomizable": true,
      "parameters": {
        "a": { "min": 2, "max": 10 },
        "b": { "min": 1, "max": 20 },
        "c": { "min": 10, "max": 50 }
      },
      "template": "{{a}}x + {{b}} = {{c}}",
      "solution": "x = ({{c}} - {{b}}) / {{a}}",
      "validation": {
        "type": "numeric",
        "tolerance": 0.01,
        "alternatives": ["({{c}}-{{b}})/{{a}}"]
      },
      "hints": [
        "Ziehe zuerst {{b}} von beiden Seiten ab",
        "Teile dann durch {{a}}"
      ],
      "feedback": {
        "correct": "Sehr gut! Du hast die Gleichung richtig gelöst.",
        "incorrect": "Fast richtig! Überprüfe deine Rechnung noch einmal."
      }
    },
    {
      "id": "mc_geometry_01",
      "topicId": "class6_geometry",
      "title": "Eigenschaften von Dreiecken",
      "description": "Welche Aussagen über Dreiecke sind korrekt?",
      "type": "multiple-choice",
      "difficulty": 2,
      "points": 15,
      "options": [
        { "id": "a", "text": "Ein Dreieck hat immer 180° Innenwinkelsumme", "correct": true },
        { "id": "b", "text": "Ein gleichseitiges Dreieck hat drei 90° Winkel", "correct": false },
        { "id": "c", "text": "Die Summe zweier Seiten ist immer größer als die dritte", "correct": true },
        { "id": "d", "text": "Ein Dreieck kann zwei rechte Winkel haben", "correct": false }
      ],
      "validation": {
        "type": "exact",
        "solution": ["a", "c"]
      }
    },
